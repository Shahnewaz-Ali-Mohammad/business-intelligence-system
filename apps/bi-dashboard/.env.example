# Real BI warehouse (Postgres) -- see apps/bi-warehouse/.env for the actual
# values used in this environment. Loaded via `node --env-file=.env.local`
# (see package.json's dev:api script) before dashboard-data.mjs/agent.mjs
# import apps/bi-warehouse's db.mjs, which reads these same var names.
WAREHOUSE_PG_HOST=localhost
WAREHOUSE_PG_PORT=5432
WAREHOUSE_PG_DATABASE=bi_warehouse
WAREHOUSE_PG_USER=
WAREHOUSE_PG_PASSWORD=

READONLY_API_URL=http://localhost:4100/api/dashboard
NEXT_PUBLIC_READONLY_API_URL=http://localhost:4100/api/dashboard
NEXT_PUBLIC_CHAT_API_URL=http://localhost:4100/api/chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Future service boundaries
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
MCP_SERVER_URL=http://localhost:4100

# Multi-database "Data Sources" feature (encrypts saved connection strings).
# Generate with: openssl rand -hex 32
WORKSPACE_SECRETS_KEY=
# Optional -- defaults to OPENAI_MODEL / gpt-4o if unset.
SCHEMA_DRAFT_MODEL=
