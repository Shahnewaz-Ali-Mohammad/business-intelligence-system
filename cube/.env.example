# Reuse the exact same warehouse credentials apps/bi-warehouse/.env already
# has -- copy this file to cube/.env and fill in the same values (don't
# invent new ones, it's the same Postgres database).
WAREHOUSE_PG_HOST=
WAREHOUSE_PG_PORT=5432
WAREHOUSE_PG_DATABASE=
WAREHOUSE_PG_USER=
WAREHOUSE_PG_PASSWORD=
# Any random long string -- generate with: openssl rand -hex 32
CUBEJS_API_SECRET=
